{
	"linter": {
		"includes": [
			"packages/**/src/**/*.ts",
			"packages/**/src/**/*.tsx",
			"packages/**/test/**/*.ts",
			"packages/**/test/**/*.tsx"
		],
		"enabled": true,
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"node:*",
									"path",
									"fs",
									"os",
									"crypto"
								],
								"message": "Native Node.js modules are forbidden. Use the utilities from 'wc-shared'."
							}
						]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": {
					"level": "off"
				}
			},
			"correctness": {
				"noUndeclaredDependencies": {
					"options": {
						"devDependencies": [
							"**/test/**",
							"**/tests/**",
							"**/*.test.*",
							"**/*.spec.*",
							"packages/wc-shared/**"
						]
					}
				},
				"noUnusedVariables": "error"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/wc-shared/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}